<?xml version="1.0" encoding="utf-8"?>
<!--
  数据提取规则：播放列表、设置、封面缓存都是明文 JSON / SharedPreferences，不应被导出。
  Android 12 起 allowBackup="false" 只覆盖云备份，设备间直传仍会执行，故两处都按
  root/file/database/sharedpref/external 五个域名全部排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
